---
// The home page in one language. src/pages/index.astro and src/pages/en/index.astro render this.
import Base from "../layouts/Base.astro";
import MobileHeader from "./MobileHeader.astro";
import MobileMenu from "./MobileMenu.astro";
import LeftColumn from "./LeftColumn.astro";
import RightNav from "./RightNav.astro";
import Hero from "./sections/Hero.astro";
import About from "./sections/About.astro";
import Services from "./sections/Services.astro";
import Works from "./sections/Works.astro";
import Team from "./sections/Team.astro";
import Process from "./sections/Process.astro";
import Contact from "./sections/Contact.astro";
import { copy, type Lang } from "../i18n";
// The Japanese service titles (.service h3) are the only text in Shippori Mincho 500.
import serviceTitleFont from "../generated/fonts/shippori-mincho-500.woff2?url";
import serviceTitleFontLatin from "@fontsource/shippori-mincho/files/shippori-mincho-latin-500-normal.woff2?url";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} path="">
  {
    /* The sections below the first screen are laid out lazily (content-visibility in global.css),
       so on phones the service titles' font would only download mid-scroll and shift the page
       under a nav jump. Preloading it fetches it at page load, as before. */
    lang === "ja" && (
      <Fragment slot="head">
        <link rel="preload" href={serviceTitleFont} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={serviceTitleFontLatin} as="font" type="font/woff2" crossorigin />
      </Fragment>
    )
  }
  <MobileHeader lang={lang} />
  <MobileMenu lang={lang} />

  <div class="layout">
    <LeftColumn lang={lang} />

    <main class="col-center" id="main">
      <Hero lang={lang} />
      <About lang={lang} />
      <Services lang={lang} />
      <Works lang={lang} />
      <Team lang={lang} />
      <Process lang={lang} />
      <Contact lang={lang} />
    </main>

    <RightNav lang={lang} />
  </div>
</Base>

<script>
  import "../scripts/nav.ts";
</script>
