---
import { Picture } from "astro:assets";
import photoMoena from "../../assets/photo-moena.jpg";
import { copy, type Lang } from "../../i18n";

interface Props {
  lang: Lang;
}

const t = copy[Astro.props.lang].team;
---

<section class="section" id="team" data-nav="team">
  <p class="eyebrow"><svg class="g" aria-hidden="true"><use href="#g-sun-s"/></svg>04 — Team</p>
  <h2 class="h2">{t.title}</h2>
  <div class="profiles">
    <article class="profile">
      <!-- 180px wide on desktop, up to 240px at 640px and below -->
      <Picture
        class="photo"
        src={photoMoena}
        formats={["avif", "webp"]}
        widths={[180, 240, 360, 480]}
        sizes="(max-width: 640px) 240px, 180px"
        alt={t.moena.name}
      />
      <div>
        <p class="role">{t.moena.role}</p>
        <h3 class="pname"><span>{t.moena.name}</span><span class="pname-en">Moena Miner</span></h3>
        <p class="pdesc">{t.moena.lead}</p>
        <p class="scope"><b>{t.scopeLabel}</b><span>{t.moena.scope}</span></p>
        <div class="skills">
          <div>
            <h4>Tools</h4>
            <ul class="chips"><li>Figma</li><li>STUDIO</li><li>Canva</li><li>Photoshop</li><li>Illustrator</li></ul>
          </div>
        </div>
      </div>
    </article>

    <article class="profile">
      <!-- Placeholder until Matthew's photo (4:5, about 800×1000) is ready -->
      <div class="ph"><span class="ph-label">Photo</span></div>
      <div>
        <p class="role">{t.matthew.role}</p>
        <h3 class="pname"><span>{t.matthew.name}</span><span class="pname-en">Matthew Ged Miner</span></h3>
        <p class="pdesc">{t.matthew.lead}</p>
        <p class="scope"><b>{t.scopeLabel}</b><span>{t.matthew.scope}</span></p>
        <div class="skills">
          <div>
            <h4 class="jp">{t.matthew.skills.web}</h4>
            <ul class="chips"><li>HTML</li><li>CSS</li><li>JavaScript</li><li>TypeScript</li><li>React</li><li>Next.js</li><li>Nuxt</li><li>NestJS</li></ul>
          </div>
          <div>
            <h4 class="jp">{t.matthew.skills.backend}</h4>
            <ul class="chips"><li>Python</li><li>Ruby on Rails</li><li>{t.matthew.skills.databaseDesign}</li></ul>
          </div>
          <div>
            <h4 class="jp">{t.matthew.skills.infra}</h4>
            <ul class="chips"><li>AWS</li><li>Terraform</li><li>Docker</li><li>Linux</li><li>Bash</li><li>Git</li><li>GitHub</li></ul>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
