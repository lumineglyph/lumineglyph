---
// A logo as inline SVG. It's drawn in currentColor, and the .logo rule sets that to --logo,
// so one file serves both themes.
import Mark from "../assets/logo-mark.svg";
import Type from "../assets/logo-type.svg";
import Symboltype from "../assets/logo-symboltype.svg";

const logos = { mark: Mark, type: Type, symboltype: Symboltype };

interface Props {
  variant: keyof typeof logos;
  alt: string; // "" for a decorative copy
  class?: string;
}

const { variant, alt, class: extraClass } = Astro.props;
const Svg = logos[variant];
---

<Svg
  class:list={["logo", extraClass]}
  role={alt ? "img" : undefined}
  aria-label={alt || undefined}
  aria-hidden={alt ? undefined : "true"}
/>
