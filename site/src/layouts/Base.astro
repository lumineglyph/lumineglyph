---
// The shell every page shares: <html lang>, <head>, the theme script and the SVG sprite.
import "../styles/global.css";
import Sprite from "../components/Sprite.astro";
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Google Fonts for now; step 02 B self-hosts them -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Noto+Sans+JP:wght@400;500&family=Shippori+Mincho:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <Sprite />
    <slot />
  </body>
</html>
